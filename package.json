{
  "name": "novo-business-centre",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @novo/api --filter @novo/web dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @novo/api prisma:generate",
    "db:migrate": "pnpm --filter @novo/api prisma:migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.6.2"
  }
}
