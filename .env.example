# Copy to .env at the repository root before running the API.
DATABASE_URL="postgresql://novo:novo_dev_password@localhost:5432/novo?schema=public"
JWT_SECRET="replace-with-a-32-character-development-secret"
WEB_ORIGIN="http://localhost:5173"
PORT="4000"
UPLOAD_DIR="./uploads"
ML_SERVICE_URL="http://localhost:8000"
# Optional: keeps generative AI disabled unless a provider is intentionally configured.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
