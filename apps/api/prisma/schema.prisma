generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  CASHIER
  FLEET_MANAGER
  CATERING_MANAGER
  FINANCE_OFFICER
  PROCUREMENT_OFFICER
  ANALYST
  VIEWER
  SUPER_ADMIN
  CHAIRMAN
  TREASURER
  BUSINESS_DEVELOPMENT
  ADMIN_STAFF
  AUDITOR
}
enum MasterDataType {
  STUDENT
  TEACHER
  EMPLOYEE
}
enum SaleStatus {
  COMPLETED
  VOIDED
}
enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  CARD
}

enum StorePaymentStatus {
  RECORDED
}
enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}
enum ShuttleBillingPeriodStatus {
  OPEN
  FINALIZED
}
enum ShuttlePaymentStatus {
  RECORDED
  VERIFIED
  REVERSED
}
enum ShuttleSettlementStatus {
  DRAFT
  APPROVED
  PAID
}
enum CateringStatus {
  DRAFT
  CONFIRMED
  PREPARING
  DELIVERED
  CANCELLED
}
enum FinancingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ACTIVE
  CLOSED
}
enum LedgerDirection {
  CREDIT
  DEBIT
}
enum ProcurementStatus {
  DRAFT
  REQUESTED
  ORDERED
  RECEIVED
  CANCELLED
}

model Tenant {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String                  @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  users                 User[]
  members               CooperativeMember[]
  masterDataRecords     MasterDataRecord[]
  masterDataImportPreviews MasterDataImportPreview[]
  products              Product[]
  productCategories     ProductCategory[]
  stockMovements        StockMovement[]
  sales                 Sale[]
  storePayments         StorePayment[]
  shuttleRoutes         ShuttleRoute[]
  shuttleSubscriptions  ShuttleSubscription[]
  shuttleBillingPeriods ShuttleBillingPeriod[]
  shuttleFinancialConfig ShuttleFinancialConfig?
  shuttleSettlements ShuttleSettlement[]
  invoices              Invoice[]
  payments              Payment[]
  settlements           Settlement[]
  cateringOrders        CateringOrder[]
  savingsAccounts       SavingsAccount[]
  financingApplications FinancingApplication[]
  procurementRequests   ProcurementRequest[]
  attachments           Attachment[]
  audits                AuditLog[]
  aiInteractions        AiInteraction[]
  knowledgeDocuments    KnowledgeDocument[]
  sessions              UserSession[]
}

model User {
  id           String              @id @default(cuid())
  tenantId     String
  memberId     String?             @unique
  email        String
  name         String
  passwordHash String
  role         UserRole            @default(VIEWER)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member       CooperativeMember?  @relation(fields: [memberId], references: [id])
  sales        Sale[]              @relation("CashierSales")
  voidedSales  Sale[]              @relation("SaleVoidedBy")
  stockMovements StockMovement[]   @relation("StockMovementActor")
  storePayments StorePayment[]     @relation("StorePaymentRecorder")
  audits       AuditLog[]          @relation("ActorAudits")
  attachments  Attachment[]        @relation("UploaderAttachments")
  sessions     UserSession[]
  masterDataImportPreviews MasterDataImportPreview[] @relation("MasterDataImportPreviewCreator")
  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model UserSession {
  id            String   @id @default(cuid())
  userId        String
  tenantId      String
  tokenHash     String   @unique
  csrfTokenHash String
  csrfToken     String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId, expiresAt])
  @@index([tenantId, expiresAt])
}
model CooperativeMember {
  id                    String                  @id @default(cuid())
  tenantId              String
  identityId            String?
  memberNo              String
  name                  String
  email                 String?
  phone                 String?
  active                Boolean                 @default(true)
  joinedAt              DateTime                @default(now())
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identity              MasterDataRecord?       @relation(fields: [identityId], references: [id], onDelete: SetNull)
  user                  User?
  subscriptions         ShuttleSubscription[]
  savingsAccounts       SavingsAccount[]
  financingApplications FinancingApplication[]
  cateringOrders        CateringOrder[]
  @@unique([tenantId, memberNo])
  @@unique([tenantId, identityId])
  @@index([tenantId, name])
}

model MasterDataRecord {
  id               String         @id @default(cuid())
  tenantId         String
  type             MasterDataType
  identifier       String
  barcode          String?
  fullName         String
  className        String?
  grade            String?
  schoolYear       String?
  department       String?
  position         String?
  email            String?
  phone            String?
  active           Boolean        @default(true)
  dataSource       String         @default("MANUAL")
  externalSimsId   String?
  lastSyncedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships      CooperativeMember[]
  customerSales    Sale[]          @relation("SaleCustomer")
  shuttleSubscriptions ShuttleSubscription[] @relation("ShuttleStudent")
  @@unique([tenantId, type, identifier])
  @@index([tenantId, type, active, fullName])
  @@index([tenantId, externalSimsId])
}
model MasterDataImportPreview {
  id          String   @id @default(cuid())
  tenantId    String
  createdById String
  fingerprint String
  payload     Json
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("MasterDataImportPreviewCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, createdById, expiresAt])
  @@index([expiresAt])
}
model ProductCategory {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenantId, name])
  @@index([tenantId, active, name])
}

model Product {
  id           String           @id @default(cuid())
  tenantId     String
  // Canonical uppercase ASCII validation is a PostgreSQL CHECK in migration 202610280006. Prisma cannot model that constraint.
  sku          String
  name         String
  description  String?
  categoryId   String?
  unitPrice    Decimal          @db.Decimal(14, 2)
  unitCost     Decimal?         @db.Decimal(14, 2)
  stockOnHand  Int              @default(0)
  reorderLevel Int              @default(0)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements    StockMovement[]
  saleItems    SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, active])
  @@index([tenantId, categoryId, active])
}

model StockMovement {
  id            String   @id @default(cuid())
  tenantId      String
  productId     String
  quantity      Int
  reason        String
  reference        String?
  // Pair integrity is enforced by SQL CHECK; Prisma cannot model that constraint.
  idempotencyKey   String?
  inputFingerprint String?
  balanceAfter  Int?
  performedById String?
  saleId        String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  performedBy   User?    @relation("StockMovementActor", fields: [performedById], references: [id], onDelete: SetNull)
  sale          Sale?    @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, saleId])
}

model Sale {
  id                 String             @id @default(cuid())
  tenantId           String
  cashierId          String
  receiptNo          String
  customerIdentityId String?
  idempotencyKey     String?
  inputFingerprint   String?
  status             SaleStatus         @default(COMPLETED)
  paymentMethod      PaymentMethod
  total              Decimal            @db.Decimal(14, 2)
  totalCost          Decimal?           @db.Decimal(14, 2)
  grossMargin        Decimal?           @db.Decimal(14, 2)
  voidReason         String?
  voidedAt           DateTime?
  voidedById         String?
  occurredAt         DateTime           @default(now())
  createdAt          DateTime           @default(now())
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashier            User               @relation("CashierSales", fields: [cashierId], references: [id])
  customerIdentity   MasterDataRecord?  @relation("SaleCustomer", fields: [customerIdentityId], references: [id], onDelete: SetNull)
  voidedBy           User?              @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  items              SaleItem[]
  payment            StorePayment?
  stockMovements     StockMovement[]

  @@unique([tenantId, receiptNo])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, occurredAt])
  @@index([tenantId, status, occurredAt])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  productId    String
  productSku   String
  productName  String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(14, 2)
  subtotal     Decimal  @db.Decimal(14, 2)
  unitCost     Decimal? @db.Decimal(14, 2)
  costSubtotal Decimal? @db.Decimal(14, 2)
  grossMargin  Decimal? @db.Decimal(14, 2)
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model StorePayment {
  id           String             @id @default(cuid())
  tenantId     String
  saleId       String             @unique
  recordedById String
  method       PaymentMethod
  status       StorePaymentStatus @default(RECORDED)
  amount       Decimal            @db.Decimal(14, 2)
  cashReceived Decimal?           @db.Decimal(14, 2)
  changeGiven  Decimal?           @db.Decimal(14, 2)
  reference    String?
  recordedAt   DateTime           @default(now())
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale         Sale               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  recordedBy   User               @relation("StorePaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([tenantId, method, recordedAt])
  @@unique([tenantId, reference])
}

model ShuttleRoute {
  id            String               @id @default(cuid())
  tenantId      String
  code          String
  name          String
  stops         Json
  monthlyRate   Decimal              @db.Decimal(14, 2)
  active        Boolean              @default(true)
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions ShuttleSubscription[]
  @@unique([tenantId, code])
}

model ShuttleSubscription {
  id        String             @id @default(cuid())
  tenantId  String
  memberId  String?
  studentIdentityId String?
  routeId   String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime?
  effectiveMonthlyRate Decimal? @db.Decimal(14, 2)
  payerName String?
  payerContact String?
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    CooperativeMember? @relation(fields: [memberId], references: [id])
  studentIdentity MasterDataRecord? @relation("ShuttleStudent", fields: [studentIdentityId], references: [id], onDelete: Restrict)
  route     ShuttleRoute       @relation(fields: [routeId], references: [id])
  invoices  Invoice[]
  // PostgreSQL enforces exactly one rider and active-rider uniqueness in
  // migration 202611040009; Prisma cannot represent these checks/indexes.
  @@index([tenantId, status])
}

model ShuttleBillingPeriod {
  id String @id @default(cuid())
  tenantId String
  startsAt DateTime
  endsAt DateTime
  timezone String @default("Asia/Jakarta")
  status ShuttleBillingPeriodStatus @default(OPEN)
  finalizedAt DateTime?
  finalizedById String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  settlements ShuttleSettlement[]
  @@unique([tenantId, startsAt])
  @@index([tenantId, status, startsAt])
}

model ShuttleFinancialConfig {
  id String @id @default(cuid())
  tenantId String @unique
  vendorName String
  vendorShareBps Int
  cooperativeShareBps Int
  active Boolean @default(true)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String              @id @default(cuid())
  tenantId       String
  subscriptionId String?
  shuttleBillingPeriodId String?
  invoiceNo      String
  description    String
  amount         Decimal             @db.Decimal(14, 2)
  status         InvoiceStatus       @default(DRAFT)
  dueDate        DateTime?
  issuedAt       DateTime?
  finalizedAt DateTime?
  finalizedById String?
  routeCodeSnapshot String?
  routeNameSnapshot String?
  rateSnapshot Decimal? @db.Decimal(14, 2)
  proratedDays Int?
  periodDays Int?
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   ShuttleSubscription? @relation(fields: [subscriptionId], references: [id])
  shuttleBillingPeriod ShuttleBillingPeriod? @relation(fields: [shuttleBillingPeriodId], references: [id], onDelete: Restrict)
  payments       Payment[]
  @@unique([tenantId, invoiceNo])
  @@index([tenantId, status])
  @@unique([tenantId, subscriptionId, shuttleBillingPeriodId])
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  invoiceId   String
  reference   String
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  /// Null indicates a non-Shuttle/generic payment.
  status ShuttlePaymentStatus?
  verifiedAt DateTime?
  verifiedById String?
  reversedAt DateTime?
  reversedById String?
  reversalReason String?
  paidAt      DateTime      @default(now())
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  settlements SettlementPayment[]
  shuttleSettlements ShuttleSettlementPayment[]
  @@unique([tenantId, reference])
}

model ShuttleSettlement {
  id String @id @default(cuid())
  tenantId String
  billingPeriodId String
  vendorNameSnapshot String
  vendorShareBps Int
  cooperativeShareBps Int
  verifiedAmount Decimal @db.Decimal(14, 2)
  vendorAmount Decimal @db.Decimal(14, 2)
  cooperativeAmount Decimal @db.Decimal(14, 2)
  status ShuttleSettlementStatus @default(DRAFT)
  approvedAt DateTime?
  approvedById String?
  paidAt DateTime?
  paidById String?
  paymentReference String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingPeriod ShuttleBillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  payments ShuttleSettlementPayment[]
  @@unique([tenantId, billingPeriodId])
}

model ShuttleSettlementPayment {
  settlementId String
  paymentId String
  settlement ShuttleSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@id([settlementId, paymentId])
  @@unique([paymentId])
}

model Settlement {
  id          String              @id @default(cuid())
  tenantId    String
  provider    String
  periodStart DateTime
  periodEnd   DateTime
  grossAmount Decimal             @db.Decimal(14, 2)
  feeAmount   Decimal             @db.Decimal(14, 2)
  netAmount   Decimal             @db.Decimal(14, 2)
  status      String              @default("PENDING")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments    SettlementPayment[]
  @@index([tenantId, periodStart])
}

model SettlementPayment {
  settlementId String
  paymentId    String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@id([settlementId, paymentId])
}

model CateringOrder {
  id           String              @id @default(cuid())
  tenantId     String
  memberId     String?
  orderNo      String
  customerName String
  deliveryAt   DateTime
  items        Json
  total        Decimal             @db.Decimal(14, 2)
  status       CateringStatus      @default(DRAFT)
  notes        String?
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member       CooperativeMember?  @relation(fields: [memberId], references: [id])
  @@unique([tenantId, orderNo])
  @@index([tenantId, deliveryAt])
}

model SavingsAccount {
  id        String                @id @default(cuid())
  tenantId  String
  memberId  String
  accountNo String
  openedAt  DateTime              @default(now())
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    CooperativeMember     @relation(fields: [memberId], references: [id])
  entries   SavingsLedgerEntry[]
  @@unique([tenantId, accountNo])
  @@unique([tenantId, memberId])
}

model SavingsLedgerEntry {
  id          String          @id @default(cuid())
  accountId   String
  direction   LedgerDirection
  amount      Decimal         @db.Decimal(14, 2)
  reference   String
  description String
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  account     SavingsAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@unique([accountId, reference])
  @@index([accountId, occurredAt])
}

model FinancingApplication {
  id            String              @id @default(cuid())
  tenantId      String
  memberId      String
  applicationNo String
  purpose       String
  principal     Decimal             @db.Decimal(14, 2)
  outstanding   Decimal             @db.Decimal(14, 2)
  status        FinancingStatus     @default(DRAFT)
  submittedAt   DateTime?
  approvedAt    DateTime?
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member        CooperativeMember   @relation(fields: [memberId], references: [id])
  receivables   Receivable[]
  @@unique([tenantId, applicationNo])
  @@index([tenantId, status])
}

model Receivable {
  id            String               @id @default(cuid())
  applicationId String
  installmentNo Int
  dueDate       DateTime
  amount        Decimal              @db.Decimal(14, 2)
  paidAmount    Decimal              @default(0) @db.Decimal(14, 2)
  application   FinancingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, installmentNo])
}

model ProcurementRequest {
  id          String            @id @default(cuid())
  tenantId    String
  requestNo   String
  supplier    String?
  description String
  amount      Decimal           @db.Decimal(14, 2)
  status      ProcurementStatus @default(DRAFT)
  requestedAt DateTime          @default(now())
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, requestNo])
}

model Attachment {
  id           String   @id @default(cuid())
  tenantId     String
  uploadedById String
  entityType   String
  entityId     String
  filename     String
  contentType  String
  size         Int
  storageKey   String
  sha256       String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("UploaderAttachments", fields: [uploadedById], references: [id])
  @@index([tenantId, entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User?    @relation("ActorAudits", fields: [actorId], references: [id])
  @@index([tenantId, entityType, entityId, createdAt])
}

model AiInteraction {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  feature   String
  prompt    String
  response  String
  model     String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, feature, createdAt])
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  content   String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, title])
}
